{
  "manifest_version": 3,
  "name": "EcomAgent 1688货源采集",
  "version": "1.0.0",
  "description": "在1688页面采集货源信息，关联EcomAgent商品",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://s.1688.com/*",
    "*://*.1688.com/*",
    "*://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://s.1688.com/*", "*://*.1688.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}